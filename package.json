{
	"name": "jinju",
	"version": "0.0.1",
	"description": "Opinionated Node CLI Toolkit",
	"keywords": [
		"cli",
		"command-line",
		"dx",
		"node",
		"toolkit"
	],
	"homepage": "https://github.com/simmo/jinju#readme",
	"bugs": "https://github.com/simmo/jinju/issues",
	"license": "MIT",
	"author": "Mike Simmonds (https://mike.id)",
	"repository": "github:simmo/jinju",
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsx --watch ./src/example.ts",
		"format:check": "oxfmt --check",
		"format": "oxfmt",
		"gen:fallow-badge": "fallow health --format badge > .github/badges/health.svg",
		"lint:fix": "oxlint --fix",
		"lint": "oxlint",
		"release": "release-it",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit --extendedDiagnostics"
	},
	"devDependencies": {
		"@release-it/keep-a-changelog": "^7.0.0",
		"@tsconfig/node-lts": "^24.0.1",
		"@types/node": "^24.13.3",
		"@vitest/coverage-v8": "^4.1.10",
		"fallow": "^3.16.0",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"release-it": "^19.0.2",
		"tsdown": "^0.23.1",
		"tsx": "^4.20.5",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"lint-staged": {
		"*": "npm run format -- --no-error-on-unmatched-pattern",
		"*.{js,jsx,ts,tsx,mjs,cjs}": "npm run lint"
	},
	"engines": {
		"node": ">=22"
	},
	"release-it": {
		"github": {
			"release": true
		},
		"plugins": {
			"@release-it/keep-a-changelog": {
				"addUnreleased": true,
				"addVersionUrl": true,
				"filename": "CHANGELOG.md"
			}
		}
	}
}
