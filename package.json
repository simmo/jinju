{
	"name": "jinju",
	"version": "0.1.0-beta.0",
	"description": "Opinionated Node CLI Toolkit",
	"keywords": [
		"cli",
		"command-line",
		"dx",
		"node",
		"toolkit"
	],
	"homepage": "https://github.com/simmo/jinju#readme",
	"bugs": "https://github.com/simmo/jinju/issues",
	"license": "MIT",
	"author": "Mike Simmonds (https://mike.id)",
	"repository": "github:simmo/jinju",
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsdown",
		"dead-code": "fallow dead-code",
		"dev": "tsx --watch ./src/example.ts",
		"format:check": "oxfmt --check",
		"format": "oxfmt",
		"gen:fallow-badge": "fallow health --format badge > .github/badges/health.svg",
		"lint:fix": "oxlint --fix",
		"lint": "oxlint",
		"release": "release-it",
		"test": "vitest --project unit",
		"test:coverage": "vitest run --coverage --project unit",
		"test:package": "vitest run --project package",
		"typecheck": "tsc --noEmit --extendedDiagnostics"
	},
	"devDependencies": {
		"@release-it/keep-a-changelog": "^8.0.1",
		"@tsconfig/node-lts": "^24.0.1",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.5",
		"fallow": "^3.34.1",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"release-it": "^21.1.1",
		"tsdown": "^0.23.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5",
		"zod": "^4.6.7"
	},
	"lint-staged": {
		"*": "npm run format -- --no-error-on-unmatched-pattern",
		"*.{js,jsx,ts,tsx,mjs,cjs}": "npm run lint"
	},
	"engines": {
		"node": ">=22.12"
	},
	"release-it": {
		"github": {
			"release": true
		},
		"npm": {
			"skipChecks": true
		},
		"plugins": {
			"@release-it/keep-a-changelog": {
				"addUnreleased": true,
				"addVersionUrl": true,
				"filename": "CHANGELOG.md"
			}
		}
	}
}
