{
	"$schema": "./node_modules/fallow/schema.json",
	// Resolves class members used through subclasses (e.g. `flag.string().required()`).
	"typeAware": {
		"enabled": true,
	},
	// Imported by the docs theme, which fallow counts as production code. The docs site is
	// only built in CI, so these stay dev dependencies.
	"ignoreDependencies": ["@shikijs/vitepress-twoslash", "vue"],
}
